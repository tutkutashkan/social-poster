# Copy this file to .env and fill it in. Never commit .env.
# A platform with empty values is skipped, so you can start with just one.

# Which day it is when deciding what's due (IANA time zone name)
POSTER_TIMEZONE=Asia/Famagusta

# X: developer.x.com > your app > Keys and tokens.
# Set the app's permissions to "Read and write" BEFORE generating the access token.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bluesky: Settings > Privacy and security > App passwords (not your login password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# LinkedIn: your app at linkedin.com/developers > Auth tab. Then run: python3 linkedin_auth.py
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Filled in by linkedin_auth.py:
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_EXPIRES=
